# Configuración del Servidor LLM (Ollama con 2x NVIDIA RTX 4090)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=EMPTY
LLM_MODEL=qwen3:32b
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=512
LLM_REQUEST_TIMEOUT=60.0

# Servidor de Embeddings (Ollama con BGE-M3 en 2x RTX 4090)
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_API_KEY=EMPTY
EMBEDDING_MODEL=bge-m3:latest

# Parámetros de Memoria de Agentes
CLASSIC_HISTORY_WINDOW=10
RAG_TOP_K=4
FALLBACK_IF_OFFLINE=false
